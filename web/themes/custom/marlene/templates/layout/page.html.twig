{#
/**
 * @file
 * The page: a sticky header (wordmark, main menu, light/dark toggle, and on small screens a menu button), the
 * banner photo (a full hero on the front page, a short band elsewhere), then breadcrumb, title and content, and the
 * footer.
 *
 * Variables added in MarleneHooks::preprocessPage(): brand, tagline, site_slogan, page_title, banner.
 */
#}
<div class="layout-container">

  <header class="site-header" data-site-header>
    <div class="site-header__inner">
      <a class="site-brand" href="{{ path('<front>') }}" rel="home">
        <svg class="site-brand__sun" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="7"/>
          <path d="M16 2.5v3.5M16 26v3.5M2.5 16H6M26 16h3.5M6.4 6.4l2.5 2.5M23.1 23.1l2.5 2.5M6.4 25.6l2.5-2.5M23.1 8.9l2.5-2.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        <span class="site-brand__name">{{ brand }}</span>
      </a>

      {% if page.primary_menu %}
        <nav class="site-nav" id="site-nav" aria-label="{{ 'Main'|t }}" data-site-nav>
          {{ page.primary_menu }}
        </nav>
      {% endif %}

      <div class="site-header__tools">
        <button type="button" class="icon-button color-scheme-toggle" data-color-scheme-toggle hidden>
          <svg class="icon icon--light" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="icon icon--dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"/></svg>
          <svg class="icon icon--auto" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z"/></svg>
          <span class="visually-hidden" data-color-scheme-label>{{ 'Color scheme'|t }}</span>
        </button>
        {% if page.primary_menu %}
          <button type="button" class="icon-button nav-toggle" aria-controls="site-nav" aria-expanded="false" data-nav-toggle hidden>
            <span class="nav-toggle__bars" aria-hidden="true"><span></span></span>
            <span class="nav-toggle__label">{{ 'Menu'|t }}</span>
          </button>
        {% endif %}
      </div>
    </div>
  </header>

  {% if banner %}
    <div class="banner{{ is_front ? ' banner--hero' }}">
      <picture class="banner__picture">
        <source type="image/webp" srcset="{{ banner.webp }}" sizes="100vw">
        <img class="banner__image" src="{{ banner.fallback }}" srcset="{{ banner.jpg }}" sizes="100vw"
          alt="{{ banner.alt }}" width="{{ banner.width }}" height="{{ banner.height }}"
          {% if is_front %}fetchpriority="high"{% endif %} decoding="async">
      </picture>
      {% if is_front %}
        <div class="banner__text">
          <p class="banner__kicker">{{ brand }}</p>
          <h1 class="banner__title">{{ tagline ?: brand }}</h1>
          {% if site_slogan %}<p class="banner__slogan">{{ site_slogan }}</p>{% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <main class="site-main" id="main-content" tabindex="-1">
    <div class="site-main__inner{{ page.sidebar_left ? ' has-sidebar' }}">
      <div class="layout-content">
        {{ page.breadcrumb }}
        {% if page_title is not empty %}
          <h1 class="page-title">{{ page_title }}</h1>
        {% endif %}
        {{ page.highlighted }}
        {{ page.content_top }}
        {{ page.content }}
        {{ page.content_bottom }}
      </div>

      {% if page.sidebar_left %}
        <aside class="layout-sidebar">
          {{ page.sidebar_left }}
        </aside>
      {% endif %}
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      {{ page.footer }}
      <p class="site-footer__brand">
        <a href="{{ path('<front>') }}">{{ brand }}</a>
        {% if tagline %}<span>{{ tagline }}</span>{% endif %}
      </p>
    </div>
  </footer>

</div>
