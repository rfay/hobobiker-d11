{#
/**
 * @file
 * A [hobophoto:] image: the 240x180 (or 180x240) derivative, linked to the full-size file.
 *
 * Same markup as the Drupal 6 site (imagecache inside a lightbox2 link), so pages keep their images and links.
 */
#}
<a rel="{{ rel }}" href="{{ href }}"><div><img src="{{ src }}" alt="{{ caption }}" title="{{ caption }}" rel="{{ rel }}" /></div></a>
